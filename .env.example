# ============================================================
# 个人职业知识管家 — 环境变量配置模板
# 复制此文件为 .env 并填入真实的 API Key
# ============================================================

# 应用
APP_NAME=个人职业知识管家
APP_VERSION=0.3.0
DEBUG=false

# ========== 数据库 ==========
# SQLite (单机开发): DATABASE_TYPE=sqlite
# PostgreSQL (生产/多用户): DATABASE_TYPE=postgres
DATABASE_TYPE=sqlite
# DATABASE_TYPE=postgres

# PostgreSQL 连接 (DATABASE_TYPE=postgres 时必填)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=career
# POSTGRES_PASSWORD=career
# POSTGRES_DB=career_kb

# ========== LLM API ==========
# DeepSeek (对话/推理) — https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_SIMPLE=deepseek-chat
LLM_MODEL_POWERFUL=deepseek-chat

# 硅基流动 (嵌入/OCR/语音) — https://siliconflow.cn
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# 嵌入模式: api (云端大模型) 或 local (本地 BGE-small)
EMBEDDING_PROVIDER=api

# ========== 数据库 ==========
# SQLite 本地路径 (默认: data/career.db)
# DATABASE_URL=sqlite+aiosqlite:///data/career.db

# ChromaDB 向量存储路径
# CHROMA_PERSIST_DIR=data/chroma

# ========== 文件上传 ==========
# 上传文件大小限制 (MB)
# MAX_UPLOAD_SIZE_MB=10
# MAX_PHOTO_SIZE_MB=2

# ========== RAG 参数 ==========
# RAG_TOP_K_RETRIEVAL=15
# RAG_TOP_K_RERANK=8
# CHUNK_MAX_CHARS=800
# CHUNK_TARGET_CHARS=400

# ========== 内网穿透 (可选, --profile tunnel) ==========
# 1. 去 https://ngrok.com 注册 (GitHub 登录即可)
# 2. 复制你的 Authtoken
# 3. (可选) 在 ngrok 控制台 Domains 页面预留一个免费固定域名
NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=yourname.ngrok-free.app  # 可选：固定域名

# ========== LangChain 追踪 (可选) ==========
# LANGCHAIN_PROJECT=career-kb
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
